+// GLSL ES 3.00 only allows constant indices into fragment output arrays, but
+// desktop GLSL (and Minecraft 26.3's OIT shaders) index them in loops. Turn each
+// `out T name[N]` into N scalar outputs fed from a plain array of the same name,
+// copied over after the original main() returns.
+std::string splitFragmentOutputArrays(const std::string& essl) {
+    static const std::regex outArray(
+        R"(layout\s*\(\s*location\s*=\s*(\d+)\s*\)\s*out\s+((?:highp|mediump|lowp)\s+)?(\w+)\s+(\w+)\s*\[\s*(\d+)\s*\]\s*;)");
+    std::string result;
+    std::string copies;
+    auto begin = std::sregex_iterator(essl.begin(), essl.end(), outArray);
+    auto end = std::sregex_iterator();
+    if (begin == end) return essl;
+
+    size_t last = 0;
+    for (auto it = begin; it != end; ++it) {
+        const std::smatch& m = *it;
+        int location = std::stoi(m[1].str());
+        std::string precision = m[2].str();
+        std::string type = m[3].str();
+        std::string name = m[4].str();
+        int count = std::stoi(m[5].str());
+
+        result.append(essl, last, m.position(0) - last);
+        for (int i = 0; i < count; i++) {
+            result += "layout(location = " + std::to_string(location + i) + ") out " + precision + type + " " + name +
+                      "_mgout" + std::to_string(i) + ";\n";
+            copies += "    " + name + "_mgout" + std::to_string(i) + " = " + name + "[" + std::to_string(i) + "];\n";
+        }
+        result += precision + type + " " + name + "[" + std::to_string(count) + "];";
+        last = m.position(0) + m.length(0);
+    }
+    result.append(essl, last, std::string::npos);
+
+    static const std::regex mainDecl(R"(\bvoid\s+main\s*\(\s*(void)?\s*\))");
+    if (!std::regex_search(result, mainDecl)) return essl;
+    result = std::regex_replace(result, mainDecl, "void mg_split_outputs_main()", std::regex_constants::format_first_only);
+    result += "\nvoid main()\n{\n    mg_split_outputs_main();\n" + copies + "}\n";
+    return result;
+}
