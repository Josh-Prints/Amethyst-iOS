+// Amethyst diagnostics: print the GLSL ES we produced and the source ANGLE
+// translated it to for a few Minecraft 26.3 world shaders, so a device log shows
+// exactly what the Metal compiler receives.
+typedef void (*PFN_GetTranslatedShaderSourceANGLE)(GLuint, GLsizei, GLsizei*, GLchar*);
+static void amethyst_dump_shader(GLuint shader) {
+    static int dumped = 0;
+    if (dumped >= 3) return;
+    GLint len = 0;
+    GLES.glGetShaderiv(shader, GL_SHADER_SOURCE_LENGTH, &len);
+    if (len <= 0) return;
+    std::string src(len, '\0');
+    GLES.glGetShaderSource(shader, len, nullptr, &src[0]);
+    if (src.find("FogSkyEnd") == std::string::npos && src.find("sampleNearest") == std::string::npos) return;
+    dumped++;
+    printf("[AmethystShaderDump] ESSL of shader %u:\n%s\n[AmethystShaderDump] end ESSL\n", shader, src.c_str());
+    static auto translated = (PFN_GetTranslatedShaderSourceANGLE)dlsym(RTLD_DEFAULT, "glGetTranslatedShaderSourceANGLE");
+    if (!translated) {
+        printf("[AmethystShaderDump] glGetTranslatedShaderSourceANGLE unavailable\n");
+        return;
+    }
+    GLint tlen = 0;
+    GLES.glGetShaderiv(shader, 0x93A0 /* GL_TRANSLATED_SHADER_SOURCE_LENGTH_ANGLE */, &tlen);
+    if (tlen <= 0) tlen = 1 << 16;
+    std::string out(tlen, '\0');
+    translated(shader, tlen, nullptr, &out[0]);
+    printf("[AmethystShaderDump] translated source of shader %u:\n%s\n[AmethystShaderDump] end translated\n", shader, out.c_str());
+    fflush(stdout);
+}
+
