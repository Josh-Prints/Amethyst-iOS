@@ -107,6 +107,24 @@
     CHECK_GL_ERROR
 }
 
+// Non-indexed draws need the same texture-buffer setup as indexed ones: Minecraft
+// 26.x draws clouds with glDrawArraysInstanced and reads their cells through an
+// emulated isamplerBuffer, whose u_BufferTexWidth would otherwise stay 0 and fold
+// every cell onto the same texel.
+void glDrawArrays(GLenum mode, GLint first, GLsizei count) {
+    LOG()
+    prepareForDraw();
+    GLES.glDrawArrays(mode, first, count);
+    CHECK_GL_ERROR
+}
+
+void glDrawArraysInstanced(GLenum mode, GLint first, GLsizei count, GLsizei instancecount) {
+    LOG()
+    prepareForDraw();
+    GLES.glDrawArraysInstanced(mode, first, count, instancecount);
+    CHECK_GL_ERROR
+}
