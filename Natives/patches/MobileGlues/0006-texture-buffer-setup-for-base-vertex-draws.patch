diff --git a/MobileGlues-cpp/gl/drawing.cpp b/MobileGlues-cpp/gl/drawing.cpp
index 9b16a7c..d8e4643 100644
--- a/MobileGlues-cpp/gl/drawing.cpp
+++ b/MobileGlues-cpp/gl/drawing.cpp
@@ -125,6 +125,26 @@ void glDrawArraysInstanced(GLenum mode, GLint first, GLsizei count, GLsizei inst
     CHECK_GL_ERROR
 }
 
+// Minecraft 26.x issues its indexed draws (clouds included) through
+// glDrawElementsInstancedBaseVertex. These used to be passed straight to the
+// driver, skipping the texture-buffer setup, so u_BufferTexWidth stayed 0 and
+// every cloud face read the same cell -- one laggy cloud above the player.
+void glDrawElementsInstancedBaseVertex(GLenum mode, GLsizei count, GLenum type, const void* indices,
+                                       GLsizei instancecount, GLint basevertex) {
+    LOG()
+    prepareForDraw();
+    GLES.glDrawElementsInstancedBaseVertex(mode, count, type, indices, instancecount, basevertex);
+    CHECK_GL_ERROR
+}
+
+void glDrawRangeElementsBaseVertex(GLenum mode, GLuint start, GLuint end, GLsizei count, GLenum type,
+                                   const void* indices, GLint basevertex) {
+    LOG()
+    prepareForDraw();
+    GLES.glDrawRangeElementsBaseVertex(mode, start, end, count, type, indices, basevertex);
+    CHECK_GL_ERROR
+}
+
 void glDrawElements(GLenum mode, GLsizei count, GLenum type, const void* indices) {
     LOG()
     LOG_D("glDrawElements, mode: %d, count: %d, type: %d, indices: %p", mode, count, type, indices)
