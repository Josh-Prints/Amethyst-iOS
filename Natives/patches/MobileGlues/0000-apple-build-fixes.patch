diff --git a/MobileGlues-cpp/CMakeLists.txt b/MobileGlues-cpp/CMakeLists.txt
index 4209b64..b1bc2b9 100644
--- a/MobileGlues-cpp/CMakeLists.txt
+++ b/MobileGlues-cpp/CMakeLists.txt
@@ -24,11 +24,24 @@ set(SPIRV_CROSS_CLI            OFF CACHE BOOL "Disable CLI binary" FORCE)
 set(SPIRV_CROSS_STATIC         ON  CACHE BOOL "Prefer static libs" FORCE)
 set(SPIRV_CROSS_ENABLE_UTIL    OFF CACHE BOOL "Disable util" FORCE)
 
+# On Apple, keep our glslang/SPIRV-Cross private. Minecraft 26.x loads its own
+# (different) copies through libshaderc and libspirv-cross, and dyld coalesces
+# exported weak C++ symbols -- templates, inline functions, vtables -- across
+# images, so the two versions got cross-wired (swizzles like pos.xz came out as
+# vec2(pos.x, pos.x), turning the world grey).
+if(APPLE)
+    set(CMAKE_CXX_VISIBILITY_PRESET hidden)
+    set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
+endif()
 add_subdirectory(3rdparty/glslang)
 add_subdirectory(3rdparty/SPIRV-Cross)
+if(APPLE)
+    unset(CMAKE_CXX_VISIBILITY_PRESET)
+    set(CMAKE_VISIBILITY_INLINES_HIDDEN OFF)
+endif()
 
 if(MACOS)
-    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -w -fvisibility=default -funwind-tables -g -D_THREAD_SAFE -fPIC -stdlib=libc++")
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -w -fvisibility=default -fvisibility-inlines-hidden -funwind-tables -g -D_THREAD_SAFE -fPIC -stdlib=libc++")
     set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -w -g -std=gnu99 -funwind-tables -fvisibility=hidden")
     set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -static-libstdc++")
 else()
@@ -157,3 +170,9 @@ if (PROFILING)
     target_link_libraries(${CMAKE_PROJECT_NAME} perfetto ${CMAKE_THREAD_LIBS_INIT})
     target_compile_definitions(${CMAKE_PROJECT_NAME} PUBLIC PROFILING=1)
 endif()
+
+if(APPLE)
+    # This file instantiates glslang/SPIRV-Cross templates and vtables; keep them
+    # out of the export table for the same reason as above.
+    set_source_files_properties(gl/glsl/glsl_for_es.cpp PROPERTIES COMPILE_OPTIONS "-fvisibility=hidden")
+endif()
